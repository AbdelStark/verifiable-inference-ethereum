+/// The words the published token vectors enter the transcript as:
+/// `len(tok_in) || tok_in || len(tok_out) || tok_out`, each id as its exact
+/// `u32`, so an id `>= P` cannot alias its residue and no split of the ids
+/// between the two vectors collides with another.  The prover and
+/// `verify_composed` mix them after tree 2 and before the first relation is
+/// drawn, so `w_residual_stream`, under which `embed_tok` and `head_tok` are
+/// Horner images of these vectors, is drawn after the vectors are fixed.
+/// `None` when both are empty: a chunk that publishes neither vector (no
+/// embedding, no argmax) mixes nothing, and its transcript is unchanged.
+pub fn token_transcript_words(tok_in: &[u32], tok_out: &[u32]) -> Option<Vec<u32>> {
+    if tok_in.is_empty() && tok_out.is_empty() {
+        return None;
+    }
+    let len = |v: &[u32]| u32::try_from(v.len()).expect("a token vector longer than u32::MAX");
+    let mut words = Vec::with_capacity(2 + tok_in.len() + tok_out.len());
+    words.push(len(tok_in));
+    words.extend_from_slice(tok_in);
+    words.push(len(tok_out));
+    words.extend_from_slice(tok_out);
+    Some(words)
+}
