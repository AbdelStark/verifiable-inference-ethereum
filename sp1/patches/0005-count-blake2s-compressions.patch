+//! BLAKE2s compression counter, behind the `count-ops` feature. Only a native host measurement
+//! build enables it; a guest never does.
+//!
+//! With the feature on, `blake2_merkle.rs` (`hash_node`) and `blake2_hash.rs`
+//! (`Blake2sHasherGeneric`: the channel and `mix_root`) take their `Blake2s256` from here: a wrapper
+//! around `blake2::Blake2s256` that hashes the same bytes and, at finalize, adds the compressions
+//! that hash ran, `max(1, ceil(n / 64))` for `n` bytes absorbed, to its site's counter. It counts per
+//! hash, never per `update` call: `hash_node` calls `update` once per 4-byte M31.
+
+use core::sync::atomic::{AtomicU64, Ordering};
+
+pub use blake2::Digest;
+use blake2::digest::{
+    FixedOutput, FixedOutputReset, HashMarker, Output, OutputSizeUser, Reset, Update,
+};
+
+/// `hash_node`'s compressions: Merkle leaves and internal nodes.
+pub static HASH_NODE: AtomicU64 = AtomicU64::new(0);
+/// `Blake2sHasherGeneric`'s compressions: the channel's mixes and draws, and `mix_root`.
+pub static CHANNEL: AtomicU64 = AtomicU64::new(0);
+
+/// The counting `Blake2s256` of `blake2_merkle.rs`.
+pub type HashNodeBlake2s256 = CountingBlake2s256<0>;
+/// The counting `Blake2s256` of `blake2_hash.rs`.
+pub type HasherBlake2s256 = CountingBlake2s256<1>;
+
+/// The counters `(hash_node, channel)`.
+pub fn counts() -> (u64, u64) {
+    (HASH_NODE.load(Ordering::Relaxed), CHANNEL.load(Ordering::Relaxed))
+}
+
+/// Sets both counters to zero.
+pub fn reset_counts() {
+    HASH_NODE.store(0, Ordering::Relaxed);
+    CHANNEL.store(0, Ordering::Relaxed);
+}
+
+/// The compressions BLAKE2s runs on `n` bytes: one per 64-byte block, the last one possibly partial,
+/// and one for the empty input.
+pub fn compressions(n: u64) -> u64 {
+    n.div_ceil(64).max(1)
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct CountingBlake2s256<const SITE: usize> {
+    inner: blake2::Blake2s256,
+    absorbed: u64,
+}
+
+impl<const SITE: usize> CountingBlake2s256<SITE> {
+    fn count(&self) {
+        let counter = if SITE == 0 { &HASH_NODE } else { &CHANNEL };
+        counter.fetch_add(compressions(self.absorbed), Ordering::Relaxed);
+    }
+}
+
+impl<const SITE: usize> HashMarker for CountingBlake2s256<SITE> {}
+
+impl<const SITE: usize> OutputSizeUser for CountingBlake2s256<SITE> {
+    type OutputSize = <blake2::Blake2s256 as OutputSizeUser>::OutputSize;
+}
+
+impl<const SITE: usize> Update for CountingBlake2s256<SITE> {
+    fn update(&mut self, data: &[u8]) {
+        self.absorbed += data.len() as u64;
+        Update::update(&mut self.inner, data);
+    }
+}
+
+impl<const SITE: usize> FixedOutput for CountingBlake2s256<SITE> {
+    fn finalize_into(self, out: &mut Output<Self>) {
+        self.count();
+        FixedOutput::finalize_into(self.inner, out);
+    }
+}
+
+impl<const SITE: usize> Reset for CountingBlake2s256<SITE> {
+    fn reset(&mut self) {
+        Reset::reset(&mut self.inner);
+        self.absorbed = 0;
+    }
+}
+
+impl<const SITE: usize> FixedOutputReset for CountingBlake2s256<SITE> {
+    fn finalize_into_reset(&mut self, out: &mut Output<Self>) {
+        self.count();
+        FixedOutputReset::finalize_into_reset(&mut self.inner, out);
+        self.absorbed = 0;
+    }
+}
