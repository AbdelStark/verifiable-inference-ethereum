+    /// verifiable-inference-ethereum (patch 0007): a layer-0 chunk's embedding
+    /// on a synthetic layer, so that a synthetic bundle publishes a `tok_in`.
+    /// Position `t` reads id `(3 + 7 t) mod vocab`, and that row of the table is
+    /// the wiring family's own input row `t`; every other row is zero.  A
+    /// witness-construction switch like `--synth-head`: without it a synthetic
+    /// layer has no table and composes exactly as it always did.
+    pub fn synth_embed(&mut self, vocab: usize) {
+        use crate::encoding::canon;
+        let g = self.residual_stream.as_ref()
+            .expect("--synth-embed needs the wiring family (--synth-residual-stream)");
+        assert!(!g.head, "--synth-embed is a layer-0 chunk's, and this is a head chunk");
+        let (d, tokens) = (g.d, self.ao.s);
+        let ids: Vec<u32> = (0..tokens).map(|t| ((3 + 7 * t) % vocab) as u32).collect();
+        let mut seen = vec![false; vocab];
+        for id in &ids {
+            assert!(!std::mem::replace(&mut seen[*id as usize], true),
+                    "--synth-embed-vocab {vocab}: id {id} repeats over {tokens} positions");
+        }
+        let mut tab = vec![0u16; vocab * d];
+        for (t, id) in ids.iter().enumerate() {
+            let row = *id as usize * d;
+            for c in 0..d {
+                tab[row + c] = canon(g.xin[t * d + c]);
+            }
+        }
+        self.embed_tab = Some(tab);
+        self.tok_in = Some(ids);
+    }
+
+    /// verifiable-inference-ethereum (patch 0007): the head chunk's argmax on a
+    /// synthetic layer, so that a synthetic bundle publishes a `tok_out`.  The
+    /// key column is the order key of the `lm_head` dequant's own output, under
+    /// the spec the plan builds for it (`deq_ref` reads only `variant` and
+    /// `round`), and each row emits its first maximum -- exactly what a dump's
+    /// `key_head.u16` and `tok_head.i32` hold.  Runs after `--synth-head`.
+    pub fn synth_argmax(&mut self, round: bf16::Round) {
+        use crate::encoding::canon;
+        use crate::gadgets::argmax::order_key;
+        assert!(self.residual_stream.as_ref().is_some_and(|g| g.head),
+                "--synth-argmax needs the head chunk (--synth-head)");
+        let m = self.mats.iter().find(|m| m.name == "lm_head")
+            .expect("--synth-argmax needs the lm_head matmul");
+        let sp = Spec {
+            variant: m.variant, round, kmax: 0, per_row: 1, limb_bits: (16, 14),
+            q_bits: 0, rem_bits: 0, fold_alpha: 0,
+        };
+        let (tokens, vocab) = (m.tokens, m.n_out);
+        let keys: Vec<u16> = (0..tokens * vocab)
+            .map(|i| order_key(canon(deq_ref(m, &sp, i / vocab, i % vocab))) as u16)
+            .collect();
+        let tok: Vec<u32> = keys.chunks(vocab)
+            .map(|row| {
+                let mx = *row.iter().max().expect("a row of the vocabulary");
+                row.iter().position(|k| *k == mx).expect("the maximum") as u32
+            })
+            .collect();
+        self.head_keys = Some(keys);
+        self.head_tok = Some(tok);
+    }
+
